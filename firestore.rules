rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ========================================
    // Règles par défaut : tout refusé
    // ========================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ========================================
    // Collection "logements"
    // ========================================
    match /logements/{logementId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.idBailleur == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.idBailleur == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.idBailleur == request.auth.uid;
    }

    // ========================================
    // Collection "users" — OUVERTE POUR TEST
    // ========================================
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // ========================================
    // Collection "equipes" — OUVERTE POUR TEST
    // ========================================
    match /equipes/{equipeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // ========================================
    // Collection "conversations" — OUVERTE POUR TEST
    // ========================================
    match /conversations/{conversationId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if false;

      // Sous-collection "messages"
      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update: if false;
        allow delete: if false;
      }
    }

  }
}