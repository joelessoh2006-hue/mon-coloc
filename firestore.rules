rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isBootstrapAdmin() {
      return signedIn()
        && request.auth.uid in [
          'JR4B6wAtRPauXlEAkh2fzBDGZ902',
          'NHP5fwv5EyZC7ooI2TvXhpRCskd2'
        ];
    }

    function isAdmin() {
      return signedIn()
        && (
          isBootstrapAdmin()
          || (
            exists(/databases/$(database)/documents/admins/$(request.auth.uid))
            && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true
          )
        );
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isMember(data) {
      return signedIn()
        && data.membres is list
        && request.auth.uid in data.membres;
    }

    function verifiedBailleur(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.role == 'bailleur'
        && get(/databases/$(database)/documents/users/$(uid)).data.estVerifie == true
        && get(/databases/$(database)/documents/users/$(uid)).data.estBloque == false;
    }

    // Admins already established in the rules above bootstrap access. Later
    // admins must have a role='admin' user document and an active registry entry.
    match /admins/{adminUid} {
      allow read: if isAdmin();

      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['active'])
        && request.resource.data.active == true
        && exists(/databases/$(database)/documents/users/$(adminUid))
        && get(/databases/$(database)/documents/users/$(adminUid)).data.role == 'admin';

      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly(['active'])
        && request.resource.data.active is bool;

      allow delete: if isAdmin();
    }

    match /users/{userId} {
      // The app currently reads other profiles for matching and messaging.
      // Keep authenticated reads while protecting privileged fields from users.
      allow read: if signedIn();

      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.role in ['etudiant', 'bailleur']
        && request.resource.data.estVerifie == false
        && request.resource.data.estBloque == false;

      allow update: if isAdmin()
        || (
          isOwner(userId)
          && request.resource.data.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'uid',
            'role',
            'estVerifie',
            'estBloque',
            'status',
            'dateValidation',
            'dateRejet',
            'dateVerification',
            'dateBlocage'
          ])
        );

      allow delete: if isAdmin();
    }

    match /logements/{logementId} {
      // Public listings are visible to signed-in users; owners and admins can
      // also read unpublished listings.
      allow read: if signedIn()
        && (
          isAdmin()
          || resource.data.status == 'valide'
          || resource.data.idBailleur == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.idBailleur == request.auth.uid
        && request.resource.data.status == 'en_attente'
        && verifiedBailleur(request.auth.uid);

      // Only admins may publish, reject, or suspend a listing.
      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.idBailleur == request.auth.uid
          && request.resource.data.idBailleur == resource.data.idBailleur
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'idBailleur',
            'status',
            'datePublication',
            'dateValidation',
            'dateRejet'
          ])
        );

      allow delete: if isAdmin()
        || (signedIn() && resource.data.idBailleur == request.auth.uid);
    }

    match /equipes/{equipeId} {
      allow read: if isAdmin() || isMember(resource.data);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['id', 'membres', 'creeLe', 'misAJourLe'])
        && request.resource.data.id == equipeId
        && request.resource.data.membres is list
        && request.resource.data.membres.size() == 2
        && request.auth.uid in request.resource.data.membres
        && request.resource.data.membres[0] != request.resource.data.membres[1];

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /visites/{visiteId} {
      allow read: if isAdmin()
        || (signedIn() && (
          resource.data.studentId == request.auth.uid
          || resource.data.bailleurId == request.auth.uid
        ));

      allow create: if signedIn()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'en_attente'
        && request.resource.data.logementId is string
        && exists(/databases/$(database)/documents/logements/$(request.resource.data.logementId))
        && get(/databases/$(database)/documents/logements/$(request.resource.data.logementId)).data.status == 'valide'
        && get(/databases/$(database)/documents/logements/$(request.resource.data.logementId)).data.idBailleur == request.resource.data.bailleurId;

      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.bailleurId == request.auth.uid
          && resource.data.status == 'en_attente'
          && request.resource.data.status in ['confirme', 'refuse']
          && request.resource.data.studentId == resource.data.studentId
          && request.resource.data.bailleurId == resource.data.bailleurId
          && request.resource.data.logementId == resource.data.logementId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        );

      allow delete: if isAdmin();
    }

    match /conversations/{conversationId} {
      allow read: if isAdmin() || isMember(resource.data);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'membres',
          'dernierMessage',
          'misAJourLe',
          'creeLe'
        ])
        && request.resource.data.membres is list
        && request.resource.data.membres.size() == 2
        && request.auth.uid in request.resource.data.membres
        && request.resource.data.membres[0] != request.resource.data.membres[1];

      allow update: if isAdmin()
        || (
          isMember(resource.data)
          && request.resource.data.membres == resource.data.membres
          && request.resource.data.creeLe == resource.data.creeLe
          && request.resource.data.keys().hasOnly([
            'membres',
            'dernierMessage',
            'misAJourLe',
            'creeLe',
            'nonLuPar',
            'demandeStatut',
            'proposePar',
            'idEquipe'
          ])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'dernierMessage',
            'misAJourLe',
            'nonLuPar',
            'demandeStatut',
            'proposePar',
            'idEquipe'
          ])
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['demandeStatut'])
            || (
              request.resource.data.demandeStatut == 'en_attente'
              && request.resource.data.proposePar == request.auth.uid
            )
            || (
              resource.data.demandeStatut == 'en_attente'
              && resource.data.proposePar != request.auth.uid
              && request.resource.data.demandeStatut in ['accepte', 'refuse']
            )
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['proposePar'])
            || request.resource.data.proposePar == request.auth.uid
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['idEquipe'])
            || request.resource.data.demandeStatut == 'accepte'
          )
        );

      allow delete: if isAdmin();

      match /messages/{messageId} {
        function canAccessParentConversation() {
          return signedIn()
            && exists(/databases/$(database)/documents/conversations/$(conversationId))
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.membres;
        }

        allow read: if isAdmin() || canAccessParentConversation();

        allow create: if canAccessParentConversation()
          && request.resource.data.keys().hasOnly(['envoyePar', 'texte', 'timestamp'])
          && request.resource.data.envoyePar == request.auth.uid
          && request.resource.data.texte is string
          && request.resource.data.timestamp == request.time;

        allow update, delete: if false;
      }
    }

    match /signalements/{signalementId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'type',
          'typeSignalement',
          'idElement',
          'cibleId',
          'cibleNom',
          'idUtilisateur',
          'auteurId',
          'auteurNom',
          'motif',
          'description',
          'conversationId',
          'dateCreation',
          'dateSignalement',
          'statut'
        ])
        && (
          request.resource.data.idUtilisateur == request.auth.uid
          || request.resource.data.auteurId == request.auth.uid
        );

      allow read, update, delete: if isAdmin();
    }

    // Everything else remains closed unless a collection receives explicit rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
